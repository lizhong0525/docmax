{
  "name": "docmax",
  "private": true,
  "version": "0.1.0",
  "description": "DocMax — 极简 Markdown 编辑器，深度集成 DeepSeek 的选区识别与精准替换",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "docx2md": "tsx scripts/docx2md.ts",
    "landing": "tsx scripts/build-landing.ts",
    "word:build": "powershell -NoProfile -ExecutionPolicy Bypass -File word-addin/build.ps1",
    "word:install": "powershell -NoProfile -ExecutionPolicy Bypass -File word-addin/install.ps1",
    "word:test": "powershell -NoProfile -ExecutionPolicy Bypass -File word-addin/test.ps1",
    "word:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File word-addin/uninstall.ps1",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "mammoth": "1.13.0",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
