# DeepSeek API（必填）：从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：兼容的 OpenAI 格式网关地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：服务端口
PORT=5199
# 可选：默认模型 deepseek-flash | deepseek-v4-pro
DOCMAX_MODEL=deepseek-flash
# 可选：docx 导入大小上限（字节），默认 25MB
DOCMAX_MAX_DOCX_BYTES=26214400
# 可选：单次生成超时（毫秒），默认 10 分钟；不限制输出长度，长文需要更久
DOCMAX_TIMEOUT_MS=600000
